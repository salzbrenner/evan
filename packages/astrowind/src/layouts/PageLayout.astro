---
import Layout from '~/layouts/Layout.astro';
import LabCard from '~/components/LabCard.astro';
import BodyContainer from '~/components/BodyContainer.astro';
import { Frame, Text } from '@evan/ui/components';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  title: string;
}

const { metadata, title } = Astro.props;
---

<Layout metadata={metadata}>
  <div class="">
    <main class="flex pl-32 gap-4">
      <div class="pt-[228px] flex flex-col gap-4">
        <Frame disabledClose absolute client:only="react" id="frame-title" sector={18}>
          <div class="max-w-[600px] break-all px-8 py-12">
            <Text accent as="h1" size="display-lg">{title}</Text>
            <Text accent size="display-lg">**********</Text>
          </div>
        </Frame>
        <BodyContainer>
          <div class="pt-64">
            <slot name="after-title" />
          </div>
        </BodyContainer>
      </div>
    </main>
    <LabCard />
  </div>
</Layout>
