---
import { Text } from '@evan/ui/components';
import { Blob, Field, HideLeva } from '../../../lab/index.ts';
import { NavigationBar } from './NavIcon';

// type Props = {
//     SIZE: string
// }

const SIZE = '218px';
// const {
//     // SIZE = '218px'
// } = Astro.props;
---

<div class="border border-clr-text-primary">
  <div transition:persist class=`w-[${SIZE + 2}px]`>
    <div
      style={{
        height: SIZE,
        width: SIZE,
      }}
      class="bg-clr-ui-bg border-b border-clr-text-primary overflow-hidden"
    >
      <Blob fov={30} client:only="react" />
    </div>
    <div
      style={{
        height: SIZE,
        width: SIZE,
      }}
      class="pt-[1px] overflow-hidden"
    >
      <div class="w-full h-full bg-clr-ui-bg">
        <Field client:only="react" />
      </div>
    </div>
    <HideLeva client:only="react" />
  </div>
  <div class="bg-clr-ui-bg flex justify-center border-t border-clr-text-primary">
    <NavigationBar currentPath={Astro.url.pathname} client:load />
  </div>
  <div class="flex justify-center border-t border-clr-text-primary cursor-move">
    <div class="bg-dot h-4 w-full bg-clr-ui-bg"></div>
  </div>
</div>
