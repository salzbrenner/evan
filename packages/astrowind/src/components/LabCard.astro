---
import { Blob, Field, HideLeva } from '../../../lab/index.ts';
import { NavigationBar } from './NavIcon';
import { Icon, IconTypes, Frame } from '@evan/ui/components';

const SIZE = 218;
---

<div transition:persist>
  <HideLeva client:only="react" />
  <Frame client:only="react" id="frame-logo" sector={91}>
    <div class="flex justify-center items-center p-8">
      <Icon type={IconTypes.logo} />
    </div>
  </Frame>
  <Frame client:only="react" id="frame-1" SIZE={`${SIZE}px`} sector={60}>
    <Field client:only="react" />
  </Frame>
  <Frame client:only="react" id="frame-0" SIZE={`${SIZE}px`} sector={108}>
    <div
      style={{
        height: `${SIZE - 2}px`,
        width: `${SIZE - 2}px`,
      }}
      class="overflow-hidden rounded-b-md"
    >
      <Blob fov={30} client:only="react" />
    </div>
  </Frame>
  <Frame client:only="react" id="frame-nav" sector={222} disabledClose>
    <div class="flex justify-center">
      <NavigationBar currentPath={Astro.url.pathname} client:load />
    </div>
  </Frame>
</div>
